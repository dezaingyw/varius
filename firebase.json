{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "funciones/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "funciones",
      "codebase": "default",
      "ignore": [
        "node_modules/**",
        ".git/**",
        "firebase-debug.log"
      ]
    }
  ]
}
